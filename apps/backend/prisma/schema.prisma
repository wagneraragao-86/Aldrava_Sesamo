generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RESIDENT
  ADMIN
}

enum DeviceType {
  GATE_CONTROLLER
  CAMERA
}

enum CallStatus {
  RINGING
  ANSWERED
  REJECTED
  ENDED
  MISSED
}

enum AccessAction {
  CALL_STARTED
  CALL_ANSWERED
  CALL_REJECTED
  CALL_ENDED
  GATE_OPENED
  GATE_DENIED
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         UserRole    @default(RESIDENT)
  calls        Call[]      @relation("ResidentCalls")
  accessLogs   AccessLog[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([role])
}

model Device {
  id          String      @id @default(cuid())
  name        String
  type        DeviceType  @default(GATE_CONTROLLER)
  tokenHash   String
  baseUrl     String?
  enabled     Boolean     @default(true)
  accessLogs  AccessLog[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, enabled])
}

model Call {
  id              String     @id @default(cuid())
  visitorName     String?
  visitorSocketId String?
  residentId      String?
  resident        User?      @relation("ResidentCalls", fields: [residentId], references: [id])
  status          CallStatus @default(RINGING)
  startedAt       DateTime   @default(now())
  answeredAt      DateTime?
  endedAt         DateTime?
  accessLogs      AccessLog[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([residentId, createdAt])
}

model AccessLog {
  id        String       @id @default(cuid())
  action    AccessAction
  ip        String?
  userAgent String?
  metadata  Json?
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  callId    String?
  call      Call?        @relation(fields: [callId], references: [id])
  deviceId  String?
  device    Device?      @relation(fields: [deviceId], references: [id])
  createdAt DateTime     @default(now())

  @@index([action, createdAt])
  @@index([callId])
  @@index([userId])
}
